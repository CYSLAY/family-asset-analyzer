# Supabase 项目地址，例如：https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 仅填写 Publishable key（sb_publishable_...）。禁止填写 Secret key 或 service_role。
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# 顾问模式前端允许显示的用户名，多个用户名用英文逗号分隔。
# 数据库 public.workspace_users 中还必须存在相同用户名且已设置密码哈希。
VITE_ALLOWED_USERNAMES=jojo
